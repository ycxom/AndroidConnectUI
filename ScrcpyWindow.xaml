<Window x:Class="AndroidConnectUI.ScrcpyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AndroidConnectUI"
        Style="{StaticResource ModernWindow}"
        Title="Android Connect · 设备视窗"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="#050607"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="screenViewport" Grid.Column="0" Background="#000000">
                <Border x:Name="screenPlaceholder" Background="#000000">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                                   Foreground="{StaticResource TextHintBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtScreenMessage" Text="正在启动 scrcpy..." Margin="0,12,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <local:ScrcpyHost x:Name="scrcpyHost"/>
            </Grid>

            <!-- Android Material 3 控制面板 -->
            <Border x:Name="controlPanel" Grid.Column="1" Width="0" Opacity="0"
                    Background="#FF1D1B20" BorderBrush="#FF49454F"
                    BorderThickness="1,0,0,0" ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Width="286" Margin="16,18">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="设备控制" FontSize="22" FontWeight="SemiBold"
                                           Foreground="#FFE6E1E5"/>
                                <TextBlock Text="Android 控制中心" FontSize="11"
                                           Foreground="#FFCAC4D0" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="&#xE76B;" Click="btnToggleControlPanel_Click"
                                    Style="{StaticResource AndroidPanelIconButton}" ToolTip="收起控制面板"/>
                        </Grid>

                        <UniformGrid Columns="2" Margin="0,0,0,20">
                            <Button Tag="power" Click="ControlTile_Click" Style="{StaticResource AndroidControlTile}">
                                <StackPanel>
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="19"/>
                                    <TextBlock Text="电源" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Button>
                            <ToggleButton x:Name="toggleAutoRotate" Style="{StaticResource AndroidQuickToggle}"
                                          Checked="toggleAutoRotate_Changed" Unchecked="toggleAutoRotate_Changed">
                                <StackPanel>
                                    <TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="19"/>
                                    <TextBlock Text="自动旋转" Margin="0,9,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <Button Tag="notifications" Click="ControlTile_Click" Style="{StaticResource AndroidControlTile}">
                                <StackPanel>
                                    <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="19"/>
                                    <TextBlock Text="通知中心" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Tag="screenshot" Click="ControlTile_Click" Style="{StaticResource AndroidControlTile}">
                                <StackPanel>
                                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="19"/>
                                    <TextBlock Text="设备截图" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <TextBlock Text="显示" Style="{StaticResource AndroidPanelSectionTitle}"/>
                        <Border Style="{StaticResource AndroidControlCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="亮度" Foreground="#FFE6E1E5"/>
                                    <TextBlock x:Name="txtBrightnessValue" Text="128" HorizontalAlignment="Right"
                                               Foreground="#FFCAC4D0"/>
                                </Grid>
                                <Slider x:Name="sliderBrightness" Tag="brightness" Minimum="1" Maximum="255"
                                        Value="128" Margin="0,10,0,0" Style="{StaticResource AndroidSlider}"
                                        ValueChanged="ControlSlider_ValueChanged"
                                        PreviewMouseLeftButtonUp="ControlSlider_Apply" KeyUp="ControlSlider_Apply"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="声音" Style="{StaticResource AndroidPanelSectionTitle}"/>
                        <Border Style="{StaticResource AndroidControlCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="媒体音量" Foreground="#FFE6E1E5"/>
                                    <TextBlock x:Name="txtVolumeValue" Text="8" HorizontalAlignment="Right"
                                               Foreground="#FFCAC4D0"/>
                                </Grid>
                                <Slider x:Name="sliderVolume" Tag="volume" Minimum="0" Maximum="15"
                                        Value="8" Margin="0,10,0,0" Style="{StaticResource AndroidSlider}"
                                        ValueChanged="ControlSlider_ValueChanged"
                                        PreviewMouseLeftButtonUp="ControlSlider_Apply" KeyUp="ControlSlider_Apply"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="屏幕方向" Style="{StaticResource AndroidPanelSectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Tag="portrait" Click="ControlTile_Click" Content="竖屏"
                                    Style="{StaticResource AndroidPillButton}"/>
                            <Button Grid.Column="2" Tag="landscape" Click="ControlTile_Click" Content="横屏"
                                    Style="{StaticResource AndroidPillButton}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- MobaXterm 风格会话状态栏 -->
        <Border Grid.Row="1" Background="#17191C" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="10,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- A ScrollViewer reports no desired width, so this decorative
                     session info can never widen the window past the video. -->
                <ScrollViewer VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="sessionDot" Width="7" Height="7"
                                 Fill="{StaticResource WarningBrush}" Margin="0,0,7,0"/>
                        <TextBlock x:Name="txtSessionStatus" Text="正在连接" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Border Width="1" Height="14" Background="{StaticResource DividerBrush}" Margin="9,0"/>
                        <TextBlock Text="设备：" FontSize="10" Foreground="{StaticResource TextHintBrush}"/>
                        <TextBlock x:Name="txtDeviceSerial" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="sessionControls" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="btnTogglePanel" Click="btnToggleControlPanel_Click"
                            Style="{StaticResource StatusBarButton}" Content="&#xE700;"
                            ToolTip="展开设备控制面板"/>
                    <Border Width="1" Height="22" Background="{StaticResource DividerBrush}" Margin="5,0,6,0"/>
                    <Button Tag="26" Click="PhysicalKey_Click" Style="{StaticResource StatusPhysicalButton}"
                            Content="&#xE7E8;" ToolTip="Power"/>

                    <Grid Width="88" Height="34" Margin="3,0">
                        <Border Margin="0,3,0,0" CornerRadius="8" Background="#B0050709"/>
                        <Border Margin="0,0,0,2" CornerRadius="8" BorderThickness="1"
                                BorderBrush="#FF59636E">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF3A424B" Offset="0"/>
                                    <GradientStop Color="#FF252B32" Offset="0.48"/>
                                    <GradientStop Color="#FF171B20" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Tag="25" Click="PhysicalKey_Click"
                                        Style="{StaticResource VolumeRockerSegment}"
                                        Content="−" ToolTip="Volume down"/>
                                <Border Grid.Column="1" Height="20" VerticalAlignment="Center"
                                        Background="#FF59636E"/>
                                <Button Grid.Column="2" Tag="24" Click="PhysicalKey_Click"
                                        Style="{StaticResource VolumeRockerSegment}"
                                        Content="+" ToolTip="Volume up"/>
                                <Border Grid.ColumnSpan="3" CornerRadius="7" BorderBrush="#55FFFFFF"
                                        BorderThickness="0,1,0,0" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Button Tag="4" Click="PhysicalKey_Click" Style="{StaticResource StatusPhysicalButton}"
                            Content="&#xE72B;" ToolTip="返回"/>
                    <Button Tag="3" Click="PhysicalKey_Click" Style="{StaticResource StatusPhysicalButton}"
                            Content="&#xE80F;" ToolTip="主页"/>
                    <Button Tag="187" Click="PhysicalKey_Click" Style="{StaticResource StatusPhysicalButton}"
                            Content="&#xE8A9;" ToolTip="最近任务"/>
                    <Border Width="1" Height="22" Background="{StaticResource DividerBrush}" Margin="6,0,4,0"/>
                    <Button Click="btnCloseSession_Click" Style="{StaticResource StatusBarButton}"
                            Content="&#xE71A;" ToolTip="关闭设备视窗"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
