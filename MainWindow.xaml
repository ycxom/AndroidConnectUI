<Window x:Class="AndroidConnectUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AndroidConnectUI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Style="{StaticResource ModernWindow}"
        Title="Android Connect"
        Height="900"
        Width="1180"
        MinHeight="700"
        MinWidth="920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource BackgroundBrush}"
        StateChanged="MainWindow_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowBorder"
            Background="{StaticResource BackgroundBrush}"
            CornerRadius="18"
            BorderThickness="0"
            Margin="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Grid Grid.Row="0" Margin="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Android Connect" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="DEVICE STUDIO" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"
                               Margin="8,0,0,0" Opacity="0.8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button x:Name="btnSettings" Content="&#xE713;" Click="btnSettings_Click"
                            Style="{StaticResource WindowCommandButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            FontFamily="Segoe MDL2 Assets" FontSize="12"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            Cursor="Hand" ToolTip="设置"/>
                    <Button x:Name="btnMinimize" Content="&#xE921;" Click="btnMinimize_Click"
                            Style="{StaticResource WindowCommandButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            FontFamily="Segoe MDL2 Assets" FontSize="12"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            Cursor="Hand"/>
                    <Button x:Name="btnMaximize" Content="&#xE922;" Click="btnMaximize_Click"
                            Style="{StaticResource WindowCommandButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            FontFamily="Segoe MDL2 Assets" FontSize="12"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            Cursor="Hand" ToolTip="最大化"/>
                    <Button x:Name="btnClose" Content="&#xE711;" Click="btnClose_Click"
                            Style="{StaticResource CloseWindowButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            FontFamily="Segoe MDL2 Assets" FontSize="12"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- 操作按钮区域 -->
            <Grid Grid.Row="1" Margin="24,6,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.ColumnSpan="7" Style="{StaticResource CardPanel}" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="8"
                                Background="#1860CDFF" Margin="0,0,10,0">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ADB 设备" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="所有操作将发送到当前选择的设备" FontSize="10"
                                       Foreground="{StaticResource TextHintBrush}"/>
                        </StackPanel>
                        <ComboBox x:Name="cmbAdbDevices" Grid.Column="2" Width="360" Height="36"
                                  Margin="12,0,8,0" Style="{StaticResource DeviceComboBox}"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="cmbAdbDevices_SelectionChanged"
                                  ToolTip="选择 ADB 设备"/>
                        <Button x:Name="btnRefreshDevices" Grid.Column="3" Content="&#xE72C;"
                                Click="btnRefreshDevices_Click"
                                Style="{StaticResource WindowCommandButton}"
                                Width="36" Height="36"
                                FontFamily="Segoe MDL2 Assets" FontSize="13"
                                ToolTip="刷新设备列表"/>
                    </Grid>
                </Border>

                <!-- 启动连接按钮 -->
                <Button x:Name="btnStart" Grid.Row="2" Grid.Column="0" Style="{StaticResource SuccessButton}"
                        Click="btnStart_Click" Height="48">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE912;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="启动连接" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 恢复分辨率按钮 -->
                <Button x:Name="btnRestore" Grid.Row="2" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                        Click="btnRestore_Click" Height="48">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="恢复分辨率" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 设置分辨率按钮 -->
                <Button x:Name="btnSetResolution" Grid.Row="2" Grid.Column="4" Style="{StaticResource PrimaryButton}"
                        Click="btnSetResolution_Click" Height="48">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE799;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="设置分辨率" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 无线ADB按钮 -->
                <Button x:Name="btnWirelessAdb" Grid.Row="2" Grid.Column="6" Style="{StaticResource SecondaryButton}"
                        Click="btnWirelessAdb_Click" Height="48">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="无线ADB" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 主内容区域 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,0,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                <!-- 左侧：系统资源监控 -->
                <Grid x:Name="ResourceTileGrid" Grid.Column="0" AllowDrop="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="175"/>
                        <RowDefinition Height="175"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE950;  系统资源" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="拖动磁贴以重新排列" Foreground="{StaticResource TextHintBrush}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{StaticResource TextHintBrush}" FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- CPU 卡片 -->
                    <Border x:Name="tileCPU" Tag="CPU" Grid.Row="1" Grid.Column="0" Style="{StaticResource DraggableTile}" Margin="0,0,6,10"
                            PreviewMouseLeftButtonDown="Tile_MouseLeftButtonDown" PreviewMouseMove="Tile_MouseMove"
                            DragEnter="Tile_DragEnter" DragLeave="Tile_DragLeave" Drop="Tile_Drop">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="80"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Row="0">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource CpuBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="CPU" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="txtCPU" Grid.Row="1" Text="0%"
                                       Style="{StaticResource MetricValue}"
                                       Foreground="{StaticResource CpuBrush}" Margin="0,4,0,4"/>

                            <local:LineChartControl x:Name="chartCPU" Grid.Row="2"
                                                    Stroke="{StaticResource CpuBrush}"
                                                    Fill="#26FF6B6B"
                                                    StrokeThickness="2"/>
                        </Grid>
                    </Border>

                    <!-- GPU 卡片 -->
                    <Border x:Name="tileGPU" Tag="GPU" Grid.Row="1" Grid.Column="1" Style="{StaticResource DraggableTile}" Margin="6,0,0,10"
                            PreviewMouseLeftButtonDown="Tile_MouseLeftButtonDown" PreviewMouseMove="Tile_MouseMove"
                            DragEnter="Tile_DragEnter" DragLeave="Tile_DragLeave" Drop="Tile_Drop">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="80"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Row="0">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource GpuBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="GPU" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="txtGPU" Grid.Row="1" Text="0%"
                                       Style="{StaticResource MetricValue}"
                                       Foreground="{StaticResource GpuBrush}" Margin="0,4,0,4"/>

                            <local:LineChartControl x:Name="chartGPU" Grid.Row="2"
                                                    Stroke="{StaticResource GpuBrush}"
                                                    Fill="#26A78BFA"
                                                    StrokeThickness="2"/>
                        </Grid>
                    </Border>

                    <!-- FPS 卡片 -->
                    <Border x:Name="tileFPS" Tag="FPS" Grid.Row="2" Grid.Column="0" Style="{StaticResource DraggableTile}" Margin="0,0,6,0"
                            PreviewMouseLeftButtonDown="Tile_MouseLeftButtonDown" PreviewMouseMove="Tile_MouseMove"
                            DragEnter="Tile_DragEnter" DragLeave="Tile_DragLeave" Drop="Tile_Drop">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="80"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Row="0">
                                <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource FpsBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="FPS" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="txtFPS" Grid.Row="1" Text="0 FPS"
                                       Style="{StaticResource MetricValue}"
                                       Foreground="{StaticResource FpsBrush}" Margin="0,4,0,4"/>

                            <local:LineChartControl x:Name="chartFPS" Grid.Row="2"
                                                    Stroke="{StaticResource FpsBrush}"
                                                    Fill="#2640FF80"
                                                    StrokeThickness="2"/>
                        </Grid>
                    </Border>

                    <!-- RAM 卡片 -->
                    <Border x:Name="tileRAM" Tag="RAM" Grid.Row="2" Grid.Column="1" Style="{StaticResource DraggableTile}" Margin="6,0,0,0"
                            PreviewMouseLeftButtonDown="Tile_MouseLeftButtonDown" PreviewMouseMove="Tile_MouseMove"
                            DragEnter="Tile_DragEnter" DragLeave="Tile_DragLeave" Drop="Tile_Drop">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="80"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Row="0">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource RamBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="RAM" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="txtRAM" Grid.Row="1" Text="0%"
                                       Style="{StaticResource MetricValue}"
                                       Foreground="{StaticResource RamBrush}" Margin="0,4,0,4"/>

                            <local:LineChartControl x:Name="chartRAM" Grid.Row="2"
                                                    Stroke="{StaticResource RamBrush}"
                                                    Fill="#2638BDF8"
                                                    StrokeThickness="2"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 右侧：手机信息 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="&#xE8E4;  设备信息" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

                    <!-- 设备状态卡片 -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 设备连接状态 -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="statusDot" Grid.Column="0"
                                         Style="{StaticResource StatusDot}"
                                         Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="设备状态" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="txtDeviceStatus" Text="未连接"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="&#xE9CA;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="{StaticResource WarningBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="设备温度" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="txtPhoneTemp" Text="--°C"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Background="{StaticResource DividerBrush}" Height="1" Margin="0,0,0,16"/>

                            <!-- 分辨率信息 -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="&#xE799;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="屏幕分辨率" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="txtResolution" Text="--"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="&#xE799;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="{StaticResource InfoBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="DPI 密度" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="txtDensity" Text="--"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 电量信息卡片 -->
                    <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 电量状态 -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="&#xE83F;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="{StaticResource SuccessBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="电量" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="txtBatteryLevel" Text="--%"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="&#xE945;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="充电状态" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="txtBatteryStatus" Text="--"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Background="{StaticResource DividerBrush}" Height="1" Margin="0,0,0,16"/>

                            <!-- 充电功率 -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="&#xE945;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="{StaticResource WarningBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="充电功率" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="txtChargePower" Text="--"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="&#xE945;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="{StaticResource CpuBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="电池温度" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock x:Name="txtBatteryTemp" Text="--°C"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 应用列表卡片 -->
                    <Border Grid.Row="3" Style="{StaticResource CardPanel}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="应用列表" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtAppCount" Text="(0)"
                                           FontSize="12" Foreground="{StaticResource TextHintBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <Button x:Name="btnLoadApps" Content="&#xE72C;" 
                                        FontFamily="Segoe MDL2 Assets" FontSize="12"
                                        Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                        BorderThickness="0" Width="32" Height="24"
                                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                        Cursor="Hand" Click="btnLoadApps_Click"
                                        Margin="8,0,0,0" ToolTip="刷新应用列表"/>
                            </StackPanel>

                            <ListView x:Name="lvApps" Grid.Row="1"
                                      Style="{StaticResource ModernListView}"
                                      MouseDoubleClick="lvApps_MouseDoubleClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="应用名称" Width="200"
                                                        HeaderContainerStyle="{StaticResource ModernGridViewColumnHeader}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" 
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="包名" Width="150"
                                                        HeaderContainerStyle="{StaticResource ModernGridViewColumnHeader}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PackageName}" 
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="4,6"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                        <GridViewRowPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#252545"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#303060"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- 物理按键卡片 -->
                    <Border Grid.Row="4" Style="{StaticResource CardPanel}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="&#xE961;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="物理按键" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="btnKeyPower" Content="&#xE7E8;"
                                        FontFamily="Segoe MDL2 Assets" FontSize="16"
                                        Background="{StaticResource CardBackgroundBrush}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                        Width="56" Height="40" Margin="0,0,8,0"
                                        Click="btnKeyPower_Click" Cursor="Hand"
                                        ToolTip="电源键">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#252545"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter Property="Background" Value="#303060"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="btnKeyVolDown" Content="&#xE929;"
                                        FontFamily="Segoe MDL2 Assets" FontSize="16"
                                        Background="{StaticResource CardBackgroundBrush}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                        Width="56" Height="40" Margin="0,0,8,0"
                                        Click="btnKeyVolDown_Click" Cursor="Hand"
                                        ToolTip="音量减">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#252545"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter Property="Background" Value="#303060"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="btnKeyVolUp" Content="&#xE92A;"
                                        FontFamily="Segoe MDL2 Assets" FontSize="16"
                                        Background="{StaticResource CardBackgroundBrush}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                        Width="56" Height="40"
                                        Click="btnKeyVolUp_Click" Cursor="Hand"
                                        ToolTip="音量加">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#252545"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter Property="Background" Value="#303060"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 休眠设置卡片 -->
                    <Border Grid.Row="5" Style="{StaticResource CardPanel}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="9" Background="#1860CDFF"
                                    Margin="0,0,10,0">
                                <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="休眠设置" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="txtSleepStatus" Text="自动检测中..." FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="管理" Click="btnSleepSettings_Click"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="14,6"/>
                        </Grid>
                    </Border>
                </Grid>
                </Grid>

                <!-- 分隔行 -->
                <Border Grid.Row="1" Background="Transparent"/>

                <!-- 日志面板 -->
                <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="运行日志" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/>
                        <Button x:Name="btnClearLog" Content="&#xE74D;" Click="btnClearLog_Click"
                                FontFamily="Segoe MDL2 Assets" FontSize="12"
                                Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderThickness="0" Width="28" Height="22"
                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                Cursor="Hand" Margin="8,0,0,0" ToolTip="清除日志"/>
                    </StackPanel>

                    <TextBox x:Name="txtLog" Grid.Row="1"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="11"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             Background="{StaticResource CardBackgroundBrush}"
                             BorderThickness="0"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"/>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

    </Grid>
</Border>
</Window>
