<Window x:Class="AndroidConnectUI.WirelessAdbDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ModernWindow}"
        Title="无线 ADB 设置"
        Width="500" MinHeight="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="无线 ADB 设置" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="将当前 USB 调试连接切换到指定 TCP 端口"
                       Margin="0,4,0,0" FontSize="12"
                       TextWrapping="Wrap" LineHeight="18"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="2" Padding="12,9" CornerRadius="8"
                Background="#1260CDFF" BorderBrush="#3060CDFF" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="当前设备：" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtDeviceSerial" Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="2,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel MinWidth="96" VerticalAlignment="Center">
                <TextBlock Text="TCP 端口" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="1024–65535" Margin="0,3,0,0" FontSize="10"
                           Foreground="{StaticResource TextHintBrush}"/>
            </StackPanel>
            <TextBox x:Name="txtPort" Grid.Column="2" Height="40" Padding="12,8"
                     FontSize="14" FontWeight="SemiBold"
                     HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                     Background="{StaticResource CardBackgroundBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                     PreviewTextInput="txtPort_PreviewTextInput"
                     KeyDown="txtPort_KeyDown"/>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="88" Height="42" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}" Click="btnCancel_Click"/>
            <Button Content="应用" Width="88" Height="42"
                    Style="{StaticResource PrimaryButton}" Click="btnApply_Click"/>
        </StackPanel>
    </Grid>
</Window>
