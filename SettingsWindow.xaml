<Window x:Class="AndroidConnectUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ModernWindow}"
        Title="休眠设置"
        Height="560"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="休眠设置" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="控制 Android 设备接通电源时是否保持唤醒" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="12,8" CornerRadius="8"
                Background="#1260CDFF" BorderBrush="#3060CDFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="当前设备：" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="txtDeviceSerial" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardPanel}" Padding="16,12">
            <RadioButton x:Name="rbDefaultSleep" GroupName="SleepMode"
                         Foreground="{StaticResource TextPrimaryBrush}" VerticalContentAlignment="Center">
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="使用系统默认休眠" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="不修改设备的正常休眠行为" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </RadioButton>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource CardPanel}" Padding="16,12">
            <RadioButton x:Name="rbUsbNoSleep" GroupName="SleepMode"
                         Foreground="{StaticResource TextPrimaryBrush}" VerticalContentAlignment="Center">
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="USB 连接时保持唤醒" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="仅在 USB 连接期间阻止设备休眠" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </RadioButton>
        </Border>

        <Border Grid.Row="7" Style="{StaticResource CardPanel}" Padding="16,12">
            <RadioButton x:Name="rbPowerNoSleep" GroupName="SleepMode"
                         Foreground="{StaticResource TextPrimaryBrush}" VerticalContentAlignment="Center">
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="接通电源时保持唤醒" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="交流电、USB 或无线充电时均阻止休眠" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </RadioButton>
        </Border>

        <Border Grid.Row="9" Style="{StaticResource CardPanel}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="窗口缩放动画" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="启动、横竖屏旋转和控制面板展开时使用平滑过渡"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,16,0"/>
                    <TextBlock Text="关闭后直接切换到最终尺寸，可减少低性能电脑的卡顿"
                               FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource TextHintBrush}" Margin="0,3,16,0"/>
                </StackPanel>
                <ToggleButton x:Name="toggleWindowAnimations" Grid.Column="1"
                              Width="52" Height="28" VerticalAlignment="Center"
                              Cursor="Hand" FocusVisualStyle="{x:Null}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="track" Background="#FF3A3D42" BorderBrush="#FF62676E"
                                    BorderThickness="1" CornerRadius="14">
                                <Ellipse x:Name="thumb" Width="20" Height="20" Margin="3"
                                         HorizontalAlignment="Left" Fill="#FFD2D7DD"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="track" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="thumb" Property="Fill" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="track" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>
        </Border>

        <TextBlock x:Name="txtLoadStatus" Grid.Row="10" Text="正在读取当前设置..." FontSize="11"
                   Foreground="{StaticResource TextHintBrush}" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="88" Height="36" Margin="0,0,10,0"
                    Click="btnCancel_Click" Style="{StaticResource SecondaryButton}" Padding="12,6"/>
            <Button x:Name="btnApply" Content="应用" Width="88" Height="36"
                    Click="btnApply_Click" Style="{StaticResource PrimaryButton}" Padding="12,6"/>
        </StackPanel>
    </Grid>
</Window>
